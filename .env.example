APP_ENV=local
LOG_LEVEL=INFO

# Bale bot token from Bale BotFather / bot management panel.
BALE_BOT_TOKEN=replace-with-bale-bot-token
BALE_API_BASE_URL=https://tapi.bale.ai
WEBHOOK_SECRET=replace-with-random-webhook-secret

# AI provider.
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL.
DATABASE_URL=postgresql+asyncpg://botbale:botbale@localhost:5432/botbale

# Security keys. Generate strong random values for production.
OTP_SECRET=replace-with-random-otp-secret
PHONE_ENCRYPTION_KEY=replace-with-fernet-key

# SMS provider. Leave SMS_PROVIDER_URL empty to log OTPs in local development.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER=BotBale

# Product limits.
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=30
OTP_TTL_SECONDS=300
SESSION_TTL_HOURS=24
